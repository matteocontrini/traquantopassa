{
	"name": "traquantopassa",
	"version": "2.0.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node -r dotenv/config build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check-updates": "npx npm-check-updates -i --format group,repo --cooldown 1d",
		"check-updates-semver": "npx npm-check-updates -i --format group,repo --cooldown 1d --target semver",
		"test": "vitest run --reporter=tree",
		"test:dev": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^25.9.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.6.0",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.7"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@lucide/svelte": "^1.21.0",
		"cheerio": "^1.2.0",
		"dotenv": "^17.4.2",
		"node-cache": "^5.1.2",
		"topbar": "^3.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
