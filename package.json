{
	"name": "traquantopassa",
	"version": "2.0.0",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node -r dotenv/config build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check-updates": "npx npm-check-updates -i --format group,repo --cooldown 1d",
		"check-updates-semver": "npx npm-check-updates -i --format group,repo --cooldown 1d --target semver",
		"test": "vitest run --reporter=tree",
		"test:dev": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"cheerio": "^1.2.0",
		"dotenv": "^18.0.9",
		"node-cache": "^5.1.2",
		"topbar": "^3.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
